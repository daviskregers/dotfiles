{
  "enabledPlugins": {
    "edurio-core@edurio-plugins": true,
    "edurio-dev@edurio-plugins": true,
    "skill-creator@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "extraKnownMarketplaces": {
    "edurio-plugins": {
      "source": {
        "repo": "edurio-dev/claude-plugins",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "afplay /System/Library/Sounds/Glass.aiff",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bun \"$HOME/.claude/hooks/dangerous-command-guard.ts\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bun \"$HOME/.claude/hooks/ai-attribution.ts\"",
            "type": "command"
          }
        ],
        "matcher": "Bash|mcp__claude_ai_Linear__save_comment|mcp__claude_ai_Linear__save_issue|mcp__custom-tools__resolve_pr_thread"
      },
      {
        "hooks": [
          {
            "command": "bun \"$HOME/.claude/hooks/comprehension-nudge.ts\"",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|NotebookEdit"
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(rg:*)",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Linear__list_comments",
      "mcp__claude_ai_Linear__list_issues"
    ]
  },
  "statusLine": {
    "command": "bash \"$HOME/.claude/statusline.sh\"",
    "type": "command"
  },
  "theme": "dark",
  "tui": "fullscreen"
}
