# Mirrors the prior wezterm setup. Kitty graphics protocol (+ Unicode placeholders)
# is enabled by default — that's what gives snacks.image true inline-in-buffer rendering.

theme = oldworld-oled
background = 000000
background-opacity = 0.92

font-family = FiraCode Nerd Font Mono
font-size = 10

window-padding-x = 0
window-padding-y = 0
window-padding-balance = true

# Left option acts as Alt (tmux/emacs Meta); right option composes for symbols like € and –.
# Latvian letters use the apostrophe dead key, so they're unaffected.
macos-option-as-alt = left

# Shift+Enter → ESC+CR (meta-enter), as in the wezterm keybind.
keybind = shift+enter=text:\x1b\r
