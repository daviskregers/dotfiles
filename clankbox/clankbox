#!/usr/bin/env bash
# clankbox — run claude/opencode inside a disposable sbx microVM sandbox.
#
# Thin wrapper over `sbx`: isolation, egress allowlist, and clone-based review are
# all sbx-native. clankbox picks the agent + image + session mode so you don't type
# the long invocation. Design: .dk-notes/plans/clankbox.md
set -euo pipefail

IMAGE="clankbox:local"

# --- locate our own source dir (follow the ~/.bin symlink back to the repo) ---
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _d="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"; [[ $_src != /* ]] && _src="$_d/$_src"
done
CLANKBOX_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
POLICY_FILE="$CLANKBOX_DIR/policy.d/default.conf"

# --- per-machine config: default agent, host model endpoints, memory cap ---
CONFIG="${CLANKBOX_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/clankbox/config}"
# shellcheck disable=SC1090
[ -f "$CONFIG" ] && . "$CONFIG"
MEM="${CLANKBOX_MEMORY:-}"

die()  { printf 'clankbox: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1 (see README.md)"; }
abspath() { (cd "$1" 2>/dev/null && pwd) || die "no such path: $1"; }

resolve_agent() {
  # precedence: flag > project .dk-notes/.agent > machine CLANKBOX_AGENT > claude
  local flag="${1:-}" a=""
  if   [ -n "$flag" ];                 then a="$flag"
  elif [ -f ".dk-notes/.agent" ];      then a="$(tr -d '[:space:]' < .dk-notes/.agent)"
  elif [ -n "${CLANKBOX_AGENT:-}" ];   then a="$CLANKBOX_AGENT"
  else                                      a="claude"
  fi
  case "$a" in
    claude|opencode) printf '%s' "$a" ;;
    *) die "unsupported agent '$a' (want claude or opencode)" ;;
  esac
}

allowlist() {
  # comma-joined host list from the default policy, plus any machine host models
  local hosts
  hosts="$(sed -E 's/#.*//; s/[[:space:]]//g; /^$/d' "$POLICY_FILE" | paste -sd, -)"
  [ -n "${CLANKBOX_HOST_MODELS:-}" ] && hosts="${hosts},${CLANKBOX_HOST_MODELS}"
  printf '%s' "$hosts"
}

# --- run-flag parser (shared by read/write); sets AGENT_FLAG, DETACHED, POS ---
AGENT_FLAG=""; DETACHED=""; NAME_FLAG=""; POS=()
parse_run_flags() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --agent)   AGENT_FLAG="${2:?--agent needs a value}"; shift 2 ;;
      --agent=*) AGENT_FLAG="${1#*=}"; shift ;;
      --name)    NAME_FLAG="${2:?--name needs a value}"; shift 2 ;;
      --name=*)  NAME_FLAG="${1#*=}"; shift ;;
      -d|--detached) DETACHED=1; shift ;;
      --) shift; POS+=("$@"); break ;;
      -*) die "unknown flag: $1" ;;
      *)  POS+=("$1"); shift ;;
    esac
  done
}

# sbx-safe, dot-free slug from a repo basename (leading dots are the typing hassle)
slugify() { printf '%s' "$1" | sed -E 's/[^a-zA-Z0-9._-]/-/g; s/-+/-/g; s/^[._-]+//; s/[._-]+$//'; }

# session name: explicit --name -> clankbox-<name>, else next free clankbox-<slug>-<n>
session_name() { # <workspace-path>
  if [ -n "$NAME_FLAG" ]; then printf 'clankbox-%s' "$(slugify "$NAME_FLAG")"; return; fi
  local slug n=1 existing; slug="$(slugify "$(basename "$1")")"
  existing="$(sbx ls --json 2>/dev/null | jq -r '.sandboxes[].name' 2>/dev/null)"
  while printf '%s\n' "$existing" | grep -qx "clankbox-$slug-$n"; do n=$((n+1)); done
  printf 'clankbox-%s-%s' "$slug" "$n"
}

# names of sandboxes whose workspace is the given host repo path
sandboxes_for_repo() { # <repo-toplevel>
  sbx ls --json 2>/dev/null | jq -r --arg r "$1" '.sandboxes[] | select(any(.workspaces[]?; . == $r)) | .name' 2>/dev/null
}

# run `sbx create ...` without the cosmetic "built for the shell agent" warning
sbx_create() { sbx "$@" 2> >(grep -vE 'WARNING: template .* was built for|sandbox may not work correctly|Consider using: sbx run -t' >&2); }

# Merge the user's claude settings over the kit's inside the sandbox, keeping the
# kit's bypassPermissions/YOLO keys and dropping host-coupled bits (see the .jq).
# Best-effort: prints " settings(merged)" on success, skips cleanly otherwise.
merge_claude_settings() {
  local name="$1" dest="$2" user="$HOME/.claude/settings.json"
  [ -f "$user" ] || return 0
  command -v jq >/dev/null 2>&1 || { printf 'clankbox: jq not found — skipping settings merge (hooks/model)\n' >&2; return 0; }
  local kit tmp; kit="$(mktemp)"; tmp="$(mktemp)"
  if sbx cp "$name:$dest/settings.json" "$kit" >/dev/null 2>&1 \
     && jq -s -f "$CLANKBOX_DIR/lib/merge-settings.jq" "$kit" "$user" > "$tmp" 2>/dev/null \
     && [ -s "$tmp" ]; then
    sbx cp "$tmp" "$name:$dest/settings.json" >/dev/null 2>&1 && printf ' settings(merged)'
  fi
  rm -f "$kit" "$tmp"
}

# Copy the user's non-secret generated config into the sandbox so the agent has
# their setup: CLAUDE.md, slash commands, agents, and hooks (run via bun in-box).
# NEVER copies credentials (~/.claude.json, sessions); settings.json is merged, not
# overwritten, so the kit's bypassPermissions survives.
inject_config() {
  local name="$1" agent="$2" base dest items item injected=""
  case "$agent" in
    claude)
      base="$HOME/.claude"; dest="/home/agent/.claude"
      items="${CLANKBOX_INJECT_CLAUDE:-CLAUDE.md commands agents hooks}" ;;
    opencode)
      base="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"; dest="/home/agent/.config/opencode"
      items="${CLANKBOX_INJECT_OPENCODE:-AGENTS.md command}" ;;
    *) return 0 ;;
  esac
  local paths=""
  for item in $items; do
    [ -e "$base/$item" ] || continue
    sbx cp "$base/$item" "$name:$dest/" >/dev/null 2>&1 && { injected="$injected $item"; paths="$paths $dest/$item"; }
  done
  if [ "$agent" = claude ]; then
    injected="$injected$(merge_claude_settings "$name" "$dest")"
    paths="$paths $dest/settings.json"
  fi
  # sbx cp lands files root-owned; hand ONLY the injected paths back to the agent
  # user. Never chown -R the whole .claude — it would recurse into the skills
  # bind-mount and touch the host source. (settings.json is agent-owned by the
  # kit's own design, so this restores, not overrides, that.)
  # shellcheck disable=SC2086
  [ -n "$injected" ] && sbx exec -u root "$name" chown -R agent:agent $paths >/dev/null 2>&1
  [ -n "$injected" ] && printf 'clankbox: injected%s into %s config\n' "$injected" "$agent" >&2
  [ "$agent" = claude ] && inject_plugins "$name"
  [ "$agent" = opencode ] && inject_opencode "$name"
  return 0
}

# opencode-specific injection: skills (opencode reads ~/.config/opencode/skills,
# which sbx doesn't mount), auth.json (surfaces all your subscription models — the
# sbx skills store is claude-only), and a merged opencode.json (your model + yolo/
# permission agent over the kit's, dropping host-coupled providers/plugins/mcp).
inject_opencode() {
  local name="$1" hostcfg="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
  local box="/home/agent/.config/opencode" share="/home/agent/.local/share/opencode" did=""
  # skills — follow the clanker/skills symlink
  if [ -e "$hostcfg/skills" ]; then
    sbx cp -L "$hostcfg/skills" "$name:$box/" >/dev/null 2>&1 && did="$did skills"
  fi
  # auth.json — all providers/models at once (opt out: CLANKBOX_INJECT_OPENCODE_AUTH=0)
  if [ "${CLANKBOX_INJECT_OPENCODE_AUTH:-1}" != 0 ] && [ -f "$HOME/.local/share/opencode/auth.json" ]; then
    sbx exec "$name" mkdir -p "$share" >/dev/null 2>&1
    sbx cp "$HOME/.local/share/opencode/auth.json" "$name:$share/auth.json" >/dev/null 2>&1 && did="$did auth"
  fi
  # opencode.json — merge your model + agent (yolo) over the kit's; drop host-coupled
  # provider/plugin/mcp (local model URLs, plannotator/notifier, bunx/npx servers)
  if [ -f "$hostcfg/opencode.json" ] && command -v jq >/dev/null 2>&1; then
    local kit tmp; kit="$(mktemp)"; tmp="$(mktemp)"
    if sbx cp "$name:$box/opencode.json" "$kit" >/dev/null 2>&1 \
       && jq -s '.[0] * (.[1] | {model, agent} | with_entries(select(.value != null)))' "$kit" "$hostcfg/opencode.json" > "$tmp" 2>/dev/null \
       && [ -s "$tmp" ]; then
      sbx cp "$tmp" "$name:$box/opencode.json" >/dev/null 2>&1 && did="$did config"
    fi
    rm -f "$kit" "$tmp"
  fi
  sbx exec -u root "$name" chown -R agent:agent "$box" "$share" >/dev/null 2>&1
  [ -n "$did" ] && printf 'clankbox: opencode ->%s\n' "$did" >&2
}

# Copy configured marketplace plugins into the sandbox OFFLINE — no gh, no network.
# The plugin cache already holds the files; we rewrite the host paths in the two
# manifests and enable the plugins in settings. Works for PRIVATE marketplaces
# without any credential in the box. Configured via CLANKBOX_INJECT_PLUGINS
# ("plugin@marketplace" entries, space-separated).
inject_plugins() {
  local name="$1" list="${CLANKBOX_INJECT_PLUGINS:-}"
  [ -n "$list" ] || return 0
  command -v jq    >/dev/null 2>&1 || { printf 'clankbox: jq not found — skipping plugins\n' >&2; return 0; }
  command -v rsync >/dev/null 2>&1 || { printf 'clankbox: rsync not found — skipping plugins\n' >&2; return 0; }
  local P="$HOME/.claude/plugins"
  [ -f "$P/known_marketplaces.json" ] || { printf 'clankbox: no host plugins to inject\n' >&2; return 0; }

  # marketplaces referenced by the plugin list (part after @)
  local p mkt mkts=""
  for p in $list; do mkt="${p#*@}"; case " $mkts " in *" $mkt "*) ;; *) mkts="$mkts $mkt" ;; esac; done

  sbx exec "$name" mkdir -p /home/agent/.claude/plugins/marketplaces /home/agent/.claude/plugins/cache >/dev/null 2>&1
  local stage; stage="$(mktemp -d)"
  for mkt in $mkts; do
    [ -d "$P/marketplaces/$mkt" ] || { printf 'clankbox: marketplace %s not on host — skipping\n' "$mkt" >&2; continue; }
    rsync -a --exclude .git "$P/marketplaces/$mkt" "$stage/" 2>/dev/null
    sbx cp "$stage/$mkt" "$name:/home/agent/.claude/plugins/marketplaces/" >/dev/null 2>&1
    [ -d "$P/cache/$mkt" ] && sbx cp "$P/cache/$mkt" "$name:/home/agent/.claude/plugins/cache/" >/dev/null 2>&1
  done

  # filtered + path-rewritten manifests (host paths -> /home/agent)
  local km ip; km="$(mktemp)"; ip="$(mktemp)"
  local keepM keepP
  keepM="$(printf '%s\n' $mkts | jq -R . | jq -s .)"
  keepP="$(printf '%s\n' $list | jq -R . | jq -s .)"
  jq --arg h "$HOME" --argjson keep "$keepM" '
    to_entries | map(select(.key as $k | $keep | index($k)))
    | map(.value.installLocation |= sub($h;"/home/agent")) | from_entries
  ' "$P/known_marketplaces.json" > "$km"
  jq --arg h "$HOME" --argjson keep "$keepP" '
    {version, plugins: (.plugins | to_entries
      | map(select(.key as $k | $keep | index($k)))
      | map(.value |= (map(select(.scope=="user")) | map(.installPath |= sub($h;"/home/agent"))))
      | from_entries)}
  ' "$P/installed_plugins.json" > "$ip"
  sbx cp "$km" "$name:/home/agent/.claude/plugins/known_marketplaces.json" >/dev/null 2>&1
  sbx cp "$ip" "$name:/home/agent/.claude/plugins/installed_plugins.json" >/dev/null 2>&1

  # enable the plugins in settings.json (add over the merged settings)
  local sk ss enj; sk="$(mktemp)"; ss="$(mktemp)"
  enj="$(printf '%s\n' $list | jq -R . | jq -s 'map({(.):true}) | add')"
  if sbx cp "$name:/home/agent/.claude/settings.json" "$sk" >/dev/null 2>&1; then
    jq --argjson en "$enj" '.enabledPlugins = ((.enabledPlugins // {}) + $en)' "$sk" > "$ss" \
      && sbx cp "$ss" "$name:/home/agent/.claude/settings.json" >/dev/null 2>&1
  fi

  sbx exec -u root "$name" chown -R agent:agent /home/agent/.claude/plugins /home/agent/.claude/settings.json >/dev/null 2>&1
  rm -f "$km" "$ip" "$sk" "$ss"
  printf 'clankbox: injected plugins:%s\n' "$list" >&2
}

# Refresh sbx's shared skills store from the host (~/.claude/skills etc.) so the
# sandbox mounts current skills. --force replaces each folder from host truth, so
# it also repairs any in-box tampering from a previous session.
sync_skills() {
  command -v sbx >/dev/null 2>&1 || return 0
  local n; n="$(sbx skills import --force 2>/dev/null | grep -c '^Importing skill')" || n=0
  [ "${n:-0}" -gt 0 ] && printf 'clankbox: synced %s skill(s) to the shared store\n' "$n" >&2
  return 0
}

run_read() {
  parse_run_flags "$@"; need sbx
  sync_skills
  local path agent name; path="$(abspath "${POS[0]:-.}")"
  agent="$(cd "$path" && resolve_agent "$AGENT_FLAG")"
  name="$(session_name "$path")"
  local args=(create --name "$name" -t "$IMAGE")
  [ -n "$MEM" ] && args+=(-m "$MEM")
  args+=("$agent" "$path:ro")
  sbx_create "${args[@]}"
  inject_config "$name" "$agent"
  exec sbx run --name "$name"
}

run_write() {
  parse_run_flags "$@"; need sbx; need git
  sync_skills
  local path agent name; path="$(abspath "${POS[0]:-.}")"
  git -C "$path" rev-parse --git-dir >/dev/null 2>&1 \
    || die "write uses --clone and needs a git repo; '$path' is not one"
  # sbx --clone wants the repo root, not a subdir — resolve to the toplevel so
  # `cbw` works from anywhere inside a repo.
  path="$(git -C "$path" rev-parse --show-toplevel)"
  agent="$(cd "$path" && resolve_agent "$AGENT_FLAG")"
  name="$(session_name "$path")"
  local args=(create --clone --name "$name" -t "$IMAGE")
  [ -n "$MEM" ] && args+=(-m "$MEM")
  args+=("$agent" "$path")
  sbx_create "${args[@]}"
  inject_config "$name" "$agent"
  if [ -n "$DETACHED" ]; then
    printf 'clankbox: created detached sandbox %s. Steer it with: clankbox attach %s\n' "$name" "$name" >&2
    return 0
  fi
  sbx run --name "$name"
  cat >&2 <<EOF

clankbox: session '$name' ended. The host tree was untouched (the box had a clone).
Review and pull the agent's work (works even if it didn't commit):
  clankbox diff        # show what changed, including untracked files
  clankbox pull        # apply those changes to your host tree, then commit yourself
Remove the sandbox when done:  clankbox rm --force $name
EOF
}

run_attach() { need sbx; local n; n="$(resolve_sandbox "${1:-}")"; exec sbx run --name "$n"; }

sandbox_exists() { sbx ls --json 2>/dev/null | jq -e --arg n "$1" 'any(.sandboxes[]?; .name==$n)' >/dev/null 2>&1; }

# Resolve a target sandbox for diff/pull/attach. Precedence: an explicit full name
# that exists; else within the current repo — a number (Nth session), a name
# selector, or the sole session. Announces the target; lists choices when ambiguous.
resolve_sandbox() {
  local arg="${1:-}" top names count name
  if [ -n "$arg" ] && sandbox_exists "$arg"; then printf '%s' "$arg"; return; fi
  top="$(git rev-parse --show-toplevel 2>/dev/null)" \
    || die "not in a git repo — pass a sandbox name (see: clankbox ls)"
  names="$(sandboxes_for_repo "$top")"
  count="$(printf '%s' "$names" | grep -c .)"
  if [ -n "$arg" ]; then
    if printf '%s' "$arg" | grep -qE '^[0-9]+$'; then
      name="$(printf '%s\n' "$names" | sed -n "${arg}p")"
      [ -n "$name" ] || die "no #$arg session for $(basename "$top")"
    else
      name="$(printf '%s\n' "$names" | grep -E "(^clankbox-|-)$arg\$" | head -1)"
      [ -n "$name" ] || die "no session matching '$arg' for $(basename "$top")"
    fi
  else
    case "$count" in
      0) die "no session for $(basename "$top") — start one with cbw" ;;
      1) name="$names" ;;
      *) printf 'clankbox: several sessions for %s — pick one (number or name):\n' "$(basename "$top")" >&2
         printf '%s\n' "$names" | nl -w2 -s'. ' >&2; exit 1 ;;
    esac
  fi
  printf 'clankbox: target %s\n' "$name" >&2
  printf '%s' "$name"
}

# Print the agent's full working-tree delta from the box (committed OR not, incl
# untracked). Diffs against the host's HEAD (the clone point); falls back to the
# box HEAD if that commit isn't in the clone. $2="--binary" for an appliable patch.
box_diff() {
  local name="$1" bin="${2:-}" hostrepo base boxtop color=""
  # color the human-readable diff; the --binary patch (for pull) must stay clean
  [ -z "$bin" ] && color="-c color.ui=always"
  hostrepo="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  base="HEAD"; [ -n "$hostrepo" ] && base="$(git -C "$hostrepo" rev-parse HEAD 2>/dev/null || echo HEAD)"
  boxtop="$(sbx exec "$name" git rev-parse --show-toplevel 2>/dev/null | tr -d '\r')"
  [ -n "$boxtop" ] || die "sandbox '$name' not found (or its workspace isn't a git repo)"
  sbx exec "$name" bash -lc "cd '$boxtop'; git add -A -N >/dev/null 2>&1; git $color --no-pager diff $bin '$base' 2>/dev/null || git $color --no-pager diff $bin HEAD"
}

run_diff() {
  need sbx; local name; name="$(resolve_sandbox "${1:-}")" || exit
  if [ -t 1 ]; then box_diff "$name" | less -RF; else box_diff "$name"; fi
}

run_pull() {
  need sbx; need git
  local name hostrepo patch; name="$(resolve_sandbox "${1:-}")" || exit
  hostrepo="$(git rev-parse --show-toplevel 2>/dev/null)" || die "run 'clankbox pull' from inside the host repo"
  patch="$(mktemp)"; box_diff "$name" --binary > "$patch"
  if [ ! -s "$patch" ]; then printf 'clankbox: no changes in %s\n' "$name" >&2; rm -f "$patch"; return 0; fi
  if git -C "$hostrepo" apply --check "$patch" >/dev/null 2>&1; then
    git -C "$hostrepo" apply "$patch"
    printf "clankbox: applied %s's changes to %s (uncommitted). Review with 'git diff' / 'git status', then commit yourself.\n" "$name" "$hostrepo" >&2
    rm -f "$patch"
  else
    local dest="$hostrepo/.clankbox-$name.patch"; cp "$patch" "$dest"; rm -f "$patch"
    printf "clankbox: patch doesn't apply cleanly (host tree diverged from the clone point). Saved to %s — inspect and 'git apply' it yourself.\n" "$dest" >&2
  fi
}

run_policy() {
  need sbx
  local hosts; hosts="$(allowlist)"
  [ -n "$hosts" ] || die "empty allowlist ($POLICY_FILE)"
  printf 'clankbox: allowing network -> %s\n' "$hosts" >&2
  sbx policy allow network "$hosts"
}

run_setup() {
  # One-time, idempotent host prep. Shared via clankbox so a fresh machine runs
  # this single command instead of rediscovering sbx's init requirements.
  need docker; need sbx
  docker info >/dev/null 2>&1 || die "docker daemon not reachable — start Docker, then re-run"
  # login gate: policy/run need Docker auth
  if ! sbx ls >/dev/null 2>&1; then
    die "not signed in to sbx — run 'sbx login', then re-run 'clankbox setup'"
  fi
  # base network policy: default-deny. Init only if not already initialized, so
  # re-running setup never wipes hosts you've since allowed from the tripwire.
  local base="${CLANKBOX_POLICY_BASE:-deny-all}"
  if sbx policy ls >/dev/null 2>&1; then
    printf 'clankbox: global policy already initialized (leaving base as-is)\n' >&2
  else
    printf 'clankbox: initializing global network policy = %s\n' "$base" >&2
    sbx policy init "$base"
  fi
  run_policy
  printf 'clankbox: setup complete. Build the image with: clankbox build\n' >&2
}

run_build() {
  need docker; need sbx
  local tar="$CLANKBOX_DIR/clankbox-image.tar"
  docker build -t "$IMAGE" "$CLANKBOX_DIR"
  docker save "$IMAGE" -o "$tar"
  sbx template load "$tar"
  printf 'clankbox: built and loaded %s\n' "$IMAGE" >&2
}

run_install() {
  mkdir -p "$HOME/.bin"
  local n
  for n in clankbox cbr cbw; do ln -sf "$CLANKBOX_DIR/clankbox" "$HOME/.bin/$n"; done
  printf 'clankbox: linked clankbox, cbr (read), cbw (write) into %s/.bin\n' "$HOME" >&2
}

usage() {
  cat <<'EOF'
clankbox — run claude/opencode in a disposable sbx sandbox.

Usage: clankbox <command> [args]

Sessions (PATH defaults to the current directory):
  write [PATH] [--agent A] [--name N] [-d]   editable session on a private clone
  read  [PATH] [--agent A] [--name N]        read-only Q&A session (:ro mount)
  attach [NAME|N]                            re-attach to a session
  diff   [NAME|N]                            show the agent's changes (incl uncommitted)
  pull   [NAME|N]                            apply those changes to your host tree

  Names: auto `clankbox-<repo>-<n>` (run several per repo), or set with --name.
  diff/pull/attach default to this repo's session; with several, pass a number
  (e.g. `clankbox pull 2`) or the name. Shorthands: cbw = write, cbr = read.

Setup:
  install          symlink this CLI into ~/.bin
  setup            one-time host prep: init default-deny policy + apply allowlist
  build            build the image and load it into sbx (docker build -> save -> load)
  policy           re-apply the default network allowlist (setup already does this)

Passthrough:
  log [NAME]       show egress allow/deny log (the tripwire) — sbx policy log
  ls               list sandboxes
  rm NAME...       remove sandboxes

First run: install sbx, `sbx login`, then `clankbox setup` and `clankbox build`.
EOF
}

# multi-call: cbr = read, cbw = write (symlinks created by `clankbox install`)
case "$(basename -- "$0")" in
  cbr) set -- read "$@" ;;
  cbw) set -- write "$@" ;;
esac

cmd="${1:-help}"; shift || true
case "$cmd" in
  write)   run_write "$@" ;;
  read)    run_read "$@" ;;
  attach)  run_attach "$@" ;;
  diff)    run_diff "$@" ;;
  pull)    run_pull "$@" ;;
  build)   run_build "$@" ;;
  install) run_install "$@" ;;
  setup)   run_setup "$@" ;;
  policy)  run_policy "$@" ;;
  log)     need sbx; exec sbx policy log "$@" ;;
  ls)      need sbx; exec sbx ls "$@" ;;
  rm)      need sbx; exec sbx rm "$@" ;;
  # hidden seams for tests (no sbx required)
  _resolve-agent) resolve_agent "${1:-}"; echo ;;
  _allowlist)     allowlist; echo ;;
  _inject)        need sbx; inject_config "${1:?sandbox name}" "${2:-claude}" ;;
  help|-h|--help) usage ;;
  *) die "unknown command '$cmd' (try: clankbox help)" ;;
esac
