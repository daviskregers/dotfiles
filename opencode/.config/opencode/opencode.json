{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "disable": false,
      "permission": {
        "bash": {
          "*": "ask",
          "git diff*": "allow",
          "git log*": "allow",
          "git status*": "allow"
        },
        "edit": "ask"
      }
    },

    "plan": {
      "disable": false
    },
    "yolo": {
      "description": "Agent that auto-accepts all edits and bash",
      "mode": "primary",
      "permission": {
        "bash": "allow",
        "edit": "allow"
      }
    }
  },
  "mcp": {
    "btca-local": {
      "command": [
        "bunx",
        "btca",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "context7": {
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "model": "github-copilot/claude-sonnet",
  "plugin": [
    "@mohak34/opencode-notifier@1.0.0"
  ],
  "provider": {
    "ollama": {
      "models": {
        "qwen3.6:27b": {
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "name": "Qwen 3.6 27B (local)"
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  }
}
