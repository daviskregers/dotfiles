{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "disable": false,
      "permission": {
        "bash": {
          "*": "ask",
          "git diff*": "allow",
          "git log*": "allow",
          "git status*": "allow"
        },
        "edit": "ask"
      }
    },

    "plan": {
      "disable": false
    },
    "yolo": {
      "description": "Agent that auto-accepts all edits and bash",
      "mode": "primary",
      "permission": {
        "bash": "allow",
        "edit": "allow"
      }
    }
  },
  "mcp": {
    "btca-local": {
      "command": [
        "bunx",
        "btca",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "context7": {
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "model": "github-copilot/claude-sonnet",
  "plugin": [
    "@plannotator/opencode@latest",
    "opencode-claude-bridge@latest",
    "@mohak34/opencode-notifier@0.2.1"
  ],
  "provider": {
    "lmstudio": {
      "models": {
        "google/gemma-4-26b-a4b": {
          "limit": {
            "context": 124300,
            "output": 8192
          },
          "name": "Gemma 4 26B A4B"
        }
      },
      "name": "LM Studio (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      }
    },
    "ollama": {
      "models": {
        "qwen3.6:27b-opencode": {
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "name": "Qwen 3.6 27B (OpenCode)"
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  }
}
