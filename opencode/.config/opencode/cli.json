{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "verbosity": "low",
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true,
  "theme": {
    "name": "vesper",
    "mode": "dark"
  },
  "tabs": {
    "mode": "off",
    "scope": "cwd"
  },
  "attention": {
    "notifications": true,
    "sound": true
  }
}
